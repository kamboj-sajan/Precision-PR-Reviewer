# ========================================================
# Precision-Based GitHub AI PR Reviewer - Environment Config
# ========================================================

# Integration Service (Node.js / Express)
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/pr_reviewer_db
AI_SERVICE_URL=http://localhost:8000
GITHUB_WEBHOOK_SECRET=development_secret_token
GITHUB_TOKEN=your_github_personal_access_token_here

# AI / RAG Service (Python / FastAPI)
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=codebase_knowledge
MOCK_LLM_MODE=true
# Any OpenAI-compatible chat API (default: Groq free tier, key from console.groq.com)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LOG_LEVEL=info

# Review queue (optional): leave SQS_QUEUE_URL empty to run reviews in-process
SQS_QUEUE_URL=
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ========================================================
# Precision-Based GitHub AI PR Reviewer - .gitignore
# ========================================================

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
*.env
!*.env.example

# Dependencies
node_modules/
.venv/
venv/
ENV/
env/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Local Databases, Vector Stores & Storage Volumes
chroma_data/
mongodb_data/
mongo_data/
*.sqlite3
*.db

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.ses
:memory:*
